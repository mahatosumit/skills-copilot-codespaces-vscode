{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mahatosumit.github.io/universal-agent-skill-os/schema/skill.schema.json",
  "title": "Universal Agent Skill",
  "type": "object",
  "required": ["id", "name", "description", "category", "author", "source", "license", "version", "compatibility", "triggers", "dependencies", "security", "quality_score", "tags", "files"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 20 },
    "category": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "source": { "type": "string" },
    "license": { "type": "string" },
    "version": { "type": "string" },
    "compatibility": { "type": "array", "items": { "enum": ["codex", "opencode", "claude-code", "copilot", "vscode", "mcp"] }, "minItems": 1, "uniqueItems": true },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "security": { "type": "string" },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": true
}
